# Plantilla de variables de entorno para tp-final-alojamiento (backend-definitivo).
# Copiar a .env (o exportar a mano / pasar con -D al JVM) y completar con
# valores reales. NINGUNA de estas tiene default hardcodeado en
# application.properties salvo las marcadas como opcionales — la app no
# arranca sin las obligatorias.

# ---------- Base de datos (obligatorias las credenciales) ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=testdb
DB_USER=
DB_PASSWORD=

# ---------- JWT (obligatoria) ----------
# Generar con: openssl rand -hex 32
JWT_SECRET=
# Opcional, en milisegundos (default: 86400000 = 24hs)
JWT_EXPIRATION=

# ---------- Cloudinary (obligatorias) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Brevo / email transaccional (obligatoria) ----------
BREVO_API_KEY=
# Opcionales
BREVO_REMITENTE_EMAIL=
BREVO_REMITENTE_NOMBRE=

# ---------- MercadoPago (obligatoria) ----------
# Usar un token que empiece con "TEST-" para no mover plata real.
MERCADOPAGO_ACCESS_TOKEN=
# Opcionales
MERCADOPAGO_MODO_PRUEBA=true
MERCADOPAGO_NOTIFICATION_URL=http://localhost:8081/Pago/webhook

# ---------- Frontend / CORS (opcionales, afectan los defaults de arriba) ----------
FRONTEND_URL=http://localhost:4200
# Separados por coma si hay mas de un origen. Sin esta, usa FRONTEND_URL.
CORS_ALLOWED_ORIGINS=

# ---------- Negocio (opcionales, tienen default razonable) ----------
PAGO_COMISION_PLATAFORMA_PORCENTAJE=5
PAGO_COMISION_MERCADOPAGO_ESTIMADA_PORCENTAJE=6
PAGO_PORCENTAJE_RETENCION_TARDIA=0.35
PAGO_JOB_VENCIMIENTO_FIXED_RATE_MS=600000

# ---------- Servidor (opcional) ----------
SERVER_PORT=8081
