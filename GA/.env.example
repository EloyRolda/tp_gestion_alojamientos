# Copiar este archivo a ".env" (o cargar estas mismas variables como variables
# de entorno del sistema/IDE) antes de levantar la aplicacion. Sin esto el
# arranque falla con "Could not resolve placeholder" (ver application.properties).

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=newgestiondb
DB_USER=root
DB_PASSWORD=

# JWT
JWT_SECRET=cambiar_esto_por_una_clave_larga_y_secreta_de_al_menos_32_caracteres
JWT_EXPIRATION=86400000

# Cloudinary (https://cloudinary.com, plan gratuito)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mercado Pago (opcional). Sin esto, los anfitriones igual pueden cargar su
# alias/CVU a mano (modo manual). Con esto, se habilita la conexion OAuth real
# ("Conectar con Mercado Pago") para que el cobro le llegue directo a su cuenta.
# Se consigue creando una app en https://www.mercadopago.com.ar/developers
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=http://localhost:8080/MercadoPago/callback
